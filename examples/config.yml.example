# Copy this to ~/.detectl/config.yml (or pass --config /path/to/this/file)
# and fill in the platform(s) you actually use. Nothing here needs to be a
# literal secret -- ${VAR_NAME} is substituted from your environment at load
# time, so tokens/secrets can stay out of the file entirely.
#
# Any field you omit here falls back to a platform-prefixed environment
# variable instead, e.g. SPLUNK_BASE_URL / SPLUNK_TOKEN, so you can skip this
# file completely and configure purely via environment if you prefer.

splunk:
  base_url: https://splunk.example.com:8089
  token: ${SPLUNK_TOKEN}
  owner: nobody           # optional, defaults to "nobody"
  app: search              # optional, defaults to "search"
  verify_ssl: true         # optional, defaults to true

elastic:
  kibana_base_url: https://kibana.example.com:5601
  es_base_url: https://elasticsearch.example.com:9200   # optional; required only for `detectl query`
  api_key: ${ELASTIC_API_KEY}
  verify_ssl: true

sentinel:
  tenant_id: ${SENTINEL_TENANT_ID}
  client_id: ${SENTINEL_CLIENT_ID}
  client_secret: ${SENTINEL_CLIENT_SECRET}
  subscription_id: ${SENTINEL_SUBSCRIPTION_ID}
  resource_group: my-sentinel-rg
  workspace_name: my-sentinel-workspace
  workspace_id: ${SENTINEL_WORKSPACE_ID}   # the Log Analytics workspace GUID, used for KQL queries

crowdstrike:
  client_id: ${CROWDSTRIKE_CLIENT_ID}
  client_secret: ${CROWDSTRIKE_CLIENT_SECRET}
  base_url: https://api.crowdstrike.com   # change for EU/Gov clouds, e.g. api.eu-1.crowdstrike.com
  # Falcon LogScale is a separate CrowdStrike product/API from the Falcon
  # platform above -- it's what powers `detectl query`, since the Falcon
  # platform API itself has no ad-hoc event search endpoint. All three are
  # optional; without them, `detectl -p crowdstrike query ...` raises
  # UnsupportedOperationError explaining how to enable it.
  logscale_url: https://cloud.crowdstrike.com       # optional; region/self-hosted URL varies
  logscale_token: ${CROWDSTRIKE_LOGSCALE_TOKEN}     # optional; a LogScale Personal API token, not the Falcon client_id/secret
  logscale_repository: search-all                    # optional, defaults to "search-all"

qradar:
  base_url: https://qradar.example.com
  token: ${QRADAR_SEC_TOKEN}      # an Authorized Service Token, sent in the SEC header (not Authorization: Bearer)
  version: "21.0"                  # optional, defaults to "21.0" -- sent in the required Version header
  verify_ssl: true                 # optional, defaults to true

sumologic:
  access_id: ${SUMOLOGIC_ACCESS_ID}
  access_key: ${SUMOLOGIC_ACCESS_KEY}
  base_url: https://api.sumologic.com/api   # optional; change for other deployments, e.g. api.us2.sumologic.com/api, api.eu.sumologic.com/api

chronicle:
  project: my-gcp-project
  location: us                              # Chronicle instance region, e.g. "us", "europe-west2"
  instance: ${CHRONICLE_INSTANCE_ID}        # the Chronicle customer/instance ID
  access_token: ${CHRONICLE_ACCESS_TOKEN}   # a pre-obtained OAuth2 bearer token (e.g. `gcloud auth print-access-token`
                                             # against a service account) -- this adapter doesn't implement Google's
                                             # service-account JWT-bearer signing flow itself, see adapters/chronicle.py
